config QCOM_MEM_BUF_DEV
	tristate "Qualcomm Kalama DMA-BUF VM permissions"
	depends on DMA_SHARED_BUFFER && QCOM_SECURE_BUFFER && GUNYAH_KALAMA_RM
	depends on ZONE_DEVICE
	help
	  Track buffer ACLs and transfer memory between HLOS, peripheral VMs
	  and Gunyah guests through SCM and the Resource Manager.

config QCOM_MEM_BUF_MSGQ
	tristate "Qualcomm Kalama memory parcel request channel"
	depends on QCOM_MEM_BUF_DEV

config QCOM_MEM_BUF
	tristate "Qualcomm Kalama host memory supplier"
	depends on QCOM_MEM_BUF_MSGQ && QCOM_DMABUF_HEAPS
	help
	  Supply protected memory to the trusted VM and expose the Android
	  /dev/membuf lend, share, retrieve and reclaim operations.
