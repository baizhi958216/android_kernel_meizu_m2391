config GUNYAH_HYPERCALLS
	tristate

config GUNYAH_TIMER
	tristate

config GUNYAH
	tristate "Gunyah Virtualization drivers"
	depends on ARM64
	select GUNYAH_PLATFORM_HOOKS
	select AUXILIARY_BUS
	imply GUNYAH_QCOM_PLATFORM if ARCH_QCOM
	select GUNYAH_HYPERCALLS
	select GUNYAH_TIMER
	depends on SYSFS
	select SYS_HYPERVISOR
	help
	  The Gunyah drivers are the helper interfaces that run in a guest VM
	  such as basic inter-VM IPC and signaling mechanisms, and higher level
	  services such as memory/device sharing, IRQ sharing, and so on.

	  Say Y/M here to enable the drivers needed to interact in a Gunyah
	  virtual environment.

config GUNYAH_PLATFORM_HOOKS
	tristate

config GUNYAH_QCOM_PLATFORM
	tristate "Support for Gunyah on Qualcomm platforms"
	depends on GUNYAH
	select GUNYAH_PLATFORM_HOOKS
	select QCOM_SCM
	help
	  Enable support for interacting with Gunyah on Qualcomm
	  platforms. Interaction with Qualcomm firmware requires
	  extra platform-specific support.

	  Say Y/M here to use Gunyah on Qualcomm platforms.

config GUNYAH_IRQFD
	tristate "Gunyah irqfd interface"
	depends on GUNYAH
	help
	  Enable kernel support for creating irqfds which can raise an interrupt
	  on Gunyah virtual machine.

	  Say Y/M here if unsure and you want to support Gunyah VMMs.

config GUNYAH_IOEVENTFD
	tristate "Gunyah ioeventfd interface"
	depends on GUNYAH
	help
	  Enable kernel support for creating ioeventfds which can alert userspace
	  when a Gunyah virtual machine accesses a memory address.

	  Say Y/M here if unsure and you want to support Gunyah VMMs.

config GUNYAH_QCOM_TRUSTED_VM
	tristate "Gunyah Qualcomm Trusted VM Support"
	depends on GUNYAH
	help
	  Enable kernel support for creating Qualcomm Trusted VMs.
	  They are a kind of protected VM which is authenticated by the
	  firmware.

	  Say Y/M here if unsure and you want to support QTVMs.

config GUNYAH_KALAMA_RM
	tristate "Kalama firmware resource manager and trusted peripheral lending"
	depends on ARM64 && OF && ARCH_QCOM
	help
	  Handle the original RM 1.0 message queues, doorbells, virtual IRQs
	  and memory parcels exposed by the Kalama boot firmware. The trusted
	  touch client uses these services to transfer its controller and IRQ
	  between the phone OS and the trusted VM.

config GUNYAH_KALAMA_VM
	tristate "Kalama secure VM userspace interface"
	depends on GUNYAH_KALAMA_RM && QCOM_MDT_LOADER && QCOM_SECURE_BUFFER
	depends on EVENTFD && SYSFS
	select SYS_HYPERVISOR
	help
	  Load the firmware specified by Kalama's secure VM device tree and
	  expose its virtio backend and vCPU scheduling ABI to the vendor VMM.
