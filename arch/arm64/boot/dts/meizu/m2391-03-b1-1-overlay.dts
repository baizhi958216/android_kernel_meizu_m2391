	fragment@67 {
		target = <0xffffffff>;

		__overlay__ {

			cam_flash_rear_active {
				phandle = <0x172>;

				mux {
					function = "gpio";
					pins = "gpio49";
				};

				config {
					output-high;
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio49";
				};
			};

			cam_flash_rear_suspend {
				phandle = <0x173>;

				mux {
					function = "gpio";
					pins = "gpio49";
				};

				config {
					output-low;
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio49";
				};
			};
		};
	};

