# SPDX-License-Identifier: GPL-2.0-only
# Apply on top of android17-6.18 gki_defconfig. Keep the normal bootloader
# command line, external ramdisks, Android module signatures and symbol CRCs.
CONFIG_COMMON_CLK_QCOM=m
CONFIG_KALAMA_TCSRCC=m
CONFIG_QCOM_COMMAND_DB=m
CONFIG_QCOM_RPMH=m
CONFIG_QCOM_CLK_RPMH=m
# The shared-memory allocator is linked with its SCM provider.
CONFIG_QCOM_SCM=m
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8550=m
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=m
CONFIG_MFD_SPMI_PMIC=m
CONFIG_SCSI_UFS_QCOM=m
CONFIG_PHY_QCOM_KALAMA_UFS=m
CONFIG_QCOM_INLINE_CRYPTO_ENGINE=m
CONFIG_REGULATOR_KALAMA_RPMH=m
CONFIG_PINCTRL_MSM=m
CONFIG_PINCTRL_KALAMA=m
CONFIG_QCOM_PDC=m
CONFIG_PINCTRL_QCOM_SPMI_PMIC=m

# Shared memory, IPCC doorbells and the always-on firmware mailbox.
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=m
CONFIG_MAILBOX=y
CONFIG_QCOM_IPCC=m
CONFIG_QCOM_SMEM=m
CONFIG_QCOM_SOCINFO=m
CONFIG_QCOM_SMP2P=m
CONFIG_QCOM_AOSS_QMP=m
CONFIG_QCOM_KALAMA_QMP=m

# Kalama's three EPSS CPU frequency domains.
CONFIG_ARM_QCOM_CPUFREQ_HW=m

# Both the application processors and GPU use the downstream Q(S)MMU v500 binding.
CONFIG_ARM_SMMU=m
CONFIG_ARM_SMMU_QCOM=m
CONFIG_ARM_SMMU_DISABLE_BYPASS_BY_DEFAULT=y

# The Flyme UFS key blobs use the HWKM v2 and shared-memory bridge protocols.
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
CONFIG_QCOM_KALAMA_HWKM=y

# Clock and power controllers consumed by the board peripherals.
CONFIG_REGULATOR_KALAMA_GDSC=m
CONFIG_KALAMA_GCC=m

# Serial engines used by the touchscreen, codecs, NFC and UWB.
CONFIG_QCOM_GPI_DMA=m
CONFIG_I2C_QCOM_GENI=m
CONFIG_SPI_QCOM_GENI=m

# PMK8550 keys, its S1 bark interrupt, and the DSI clock and panel providers.
CONFIG_POWER_RESET_QCOM_PON=m
CONFIG_INPUT_PM8941_PWRKEY=m
CONFIG_KALAMA_DISPCC=m
CONFIG_QCOM_PANEL_EVENT_NOTIFIER=m

# ADSP firmware channels for the Type-C port, battery and USB role services.
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_UCSI_PMIC_GLINK=m

# Flyme USB gadget compositions and modem packet devices.
CONFIG_USB_DWC3_QCOM_GSI=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_GSI=m
CONFIG_USB_F_CDEV=m
CONFIG_USB_F_DIAG=m
CONFIG_USB_F_CCID=m
CONFIG_USB_F_QDSS=m
CONFIG_USB_F_AUDIO_SRC=m
CONFIG_QCOM_GLINK_PKT=m
CONFIG_SND_SOC_USB=m
CONFIG_SND_USB_AUDIO_QMI=m
CONFIG_TYPEC_MUX_FSA4480=m
CONFIG_PHY_SNPS_EUSB2=m
CONFIG_PHY_QCOM_EUSB2_REPEATER=m
CONFIG_PHY_QCOM_QMP=m
CONFIG_PHY_QCOM_QMP_COMBO=m

# Firmware-authenticated ADSP, CDSP and modem with their RPMSG service channels.
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=m
CONFIG_RPMSG_CHAR=m

# Kalama external display driver uses the DRM DP AUX and MST helpers.
CONFIG_DRM_KALAMA_SDE_HELPERS=m

# Adreno, camera and video power and clock trees.
CONFIG_KALAMA_GPUCC=m
CONFIG_KALAMA_CAMCC=m
CONFIG_KALAMA_VIDEOCC=m
CONFIG_QCOM_KALAMA_DSP_LOADER=m
CONFIG_MSM_ADSPRPC=m
CONFIG_GUNYAH_KALAMA_RM=m
CONFIG_GUNYAH_KALAMA_VM=m

# Finger-detect GPIO, firmware IRQ and the fingerprint touch-area event ABI.
CONFIG_MSM_QBT_HANDLER=m
CONFIG_QCOM_SECURE_BUFFER=m
CONFIG_ZONE_DEVICE=y
CONFIG_QCOM_MEM_BUF_DEV=m
# CONFIG_DMABUF_HEAPS_SYSTEM is not set
CONFIG_QCOM_DMABUF_HEAPS=m
CONFIG_CMA_AREAS=32
CONFIG_QCOM_KALAMA_SHMBRIDGE=m
CONFIG_IPC_LOGGING=m
CONFIG_QCOM_MEM_BUF_MSGQ=m
CONFIG_QCOM_MEM_BUF=m
CONFIG_MSM_PERFORMANCE=m
CONFIG_QCOM_DCVS_FP=m
CONFIG_QCOM_DCVS=m

# Kiwi v2 WLAN firmware transport, vendor nl80211 interface and BT audio bus.
CONFIG_MHI_BUS=m
CONFIG_MHI_BUS_MISC=y
CONFIG_MHI_SATELLITE=m
CONFIG_QRTR_MHI=m
CONFIG_CFG80211=m
CONFIG_NL80211_TESTMODE=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
# CONFIG_CFG80211_DEFAULT_PS is not set
CONFIG_SLIMBUS=m
CONFIG_SLIM_QCOM_NGD_CTRL=m
CONFIG_PCI_MSM=m

# Android modem, RMNET, tethering and WLAN offload client ABI.
CONFIG_IPA3=m
CONFIG_MSM_GLOBAL_SYNX=m

# PM8550B haptics calibration storage and programmable boot sequences.
CONFIG_QCOM_PBS=m
CONFIG_NVMEM_SPMI_SDAM=m

# AKS accessory ADC samples use the IIO triggered FIFO.
CONFIG_IIO_TRIGGERED_BUFFER=m
CONFIG_IIO_BUFFER_CB=m

# On-die TSENS and SPMI PMIC temperature alarms
CONFIG_NVMEM_QCOM_QFPROM=m
CONFIG_QCOM_TSENS=m
CONFIG_QCOM_SPMI_TEMP_ALARM=m
CONFIG_QCOM_SPMI_ADC5_GEN3=m
CONFIG_QCOM_SPMI_ADC_TM5_GEN3=m

# Meizu board identity and secure processor services.
CONFIG_MEIZU_DEVICE_INFO=m
CONFIG_QCOM_SPSS=m
CONFIG_MSM_SPCOM=m
CONFIG_MSM_SPSS_UTILS=m
CONFIG_QSEE_IPC_IRQ_BRIDGE=m

# Userspace and firmware thermal controls on the Kalama CPU and modem.
CONFIG_MEIZU_THERMAL_BOOST=m
CONFIG_QTI_CPUFREQ_CDEV=m
CONFIG_QTI_CPU_VOLTAGE_COOLING_DEVICE=m
CONFIG_QTI_QMI_COOLING_DEVICE=m
CONFIG_QTI_CPU_HOTPLUG_COOLING_DEVICE=m
CONFIG_QTI_DDR_COOLING_DEVICE=m
CONFIG_QTI_USERSPACE_CDEV=m

# Remote modem thermometry and PMIC battery-protection zones.
CONFIG_QTI_QMI_SENSOR_V2=m
CONFIG_QTI_BCL_PMIC5=m
CONFIG_QTI_BCL_SOC_DRIVER=m

# PMK8550 32-kHz RTC and alarm on SPMI USID 0.
CONFIG_RTC_DRV_PM8XXX=m

# PM8550 LPG, notification LEDs, camera flash and PMIC OCP notifications.
CONFIG_LEDS_QTI_FLASH=m
CONFIG_LEDS_QTI_TRI_LED=m
CONFIG_REGULATOR_QTI_OCP_NOTIFIER=m
CONFIG_PWM_QTI_LPG=m
CONFIG_QCOM_BAM_DMA=m
CONFIG_SPS=m

# Shared CPU, GPU, video, display, DSP and camera system-cache slices.
CONFIG_QCOM_LLCC=m
CONFIG_SCHED_WALT=m
CONFIG_QCOM_MODEM_MEMSHARE=m
CONFIG_QCOM_KALAMA_CDSPRM=m
CONFIG_UIO_MSM_SHAREDMEM=m

# PMIC power-on history and reboot reason in SDAM.
CONFIG_POWER_RESET_QCOM_REBOOT_REASON=m
CONFIG_QTI_PMIC_PON_LOG=m
CONFIG_QTI_CPU_PAUSE_COOLING_DEVICE=m
CONFIG_MEIZU_VIP_TASK=y

# CPU, RPMh and remote subsystem sleep accounting.
CONFIG_QCOM_CPUSS_SLEEP_STATS=m
CONFIG_QCOM_SOC_SLEEP_STATS=m
CONFIG_QCOM_SUBSYSTEM_SLEEP_STATS=m
CONFIG_QCOM_SMP2P_SLEEPSTATE=m

# PSCI CPU and cluster low-power policy.
CONFIG_CPU_IDLE_GOV_QCOM_LPM=m

# Hardware and firmware CPU/cache/memory bandwidth monitors.
CONFIG_QCOM_LLCC_PMU=m
CONFIG_QTI_SCMI_PMU_PROTOCOL=m
CONFIG_QTI_SCMI_MEMLAT_PROTOCOL=m
CONFIG_QTI_SCMI_CPUFREQ_STATS_PROTOCOL=m
CONFIG_QTI_CPUFREQ_STATS_SCMI_CLIENT=m
CONFIG_QTI_SCMI_C1DCVS_PROTOCOL=m
CONFIG_QTI_C1DCVS_SCMI_CLIENT=m
CONFIG_QCOM_PMU_LIB=m
CONFIG_QCOM_MEMLAT=m
CONFIG_QCOM_BWMON=m
CONFIG_QTI_PMU_SCMI_CLIENT=m
CONFIG_QTI_HW_MEMLAT_SCMI_CLIENT=m
CONFIG_MEIZU_FREQ_QOS=y

# Bootloader IMEM timestamps and 32 kHz MPM timer.
CONFIG_MSM_BOOT_STATS=m
CONFIG_QCOM_SYSMON_SUBSYSTEM_STATS=m
CONFIG_QCOM_ADSP_SLEEPMON=m
CONFIG_QTI_THERMAL_LIMITS_DCVS=m
CONFIG_QTI_DEVFREQ_CDEV=m

# Flyme swap service sets per-app policy in the legacy memory controller.
CONFIG_MEMCG_V1=y
CONFIG_ZRAM_MEIZU_SMARTSWAP=y
